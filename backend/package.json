{
  "name": "minifinance-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit --reporter=default --reporter=junit --outputFile.junit=test-reports/unit.xml",
    "test:integration": "vitest run --project integration --reporter=default --reporter=junit --outputFile.junit=test-reports/integration.xml",
    "test:coverage": "vitest run --project unit --coverage --reporter=default --reporter=junit --outputFile.junit=test-reports/coverage.xml",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed:demo": "node --env-file-if-exists=.env --import tsx src/db/seed-demo.ts",
    "build:test-server": "tsc -p tsconfig.integration.json"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
